<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Requires the WeatherKit capability on the App ID in the developer
       portal. Without it the app still runs; WeatherBridge throws and the
       web layer falls back to the National Weather Service. -->
  <key>com.apple.developer.weatherkit</key>
  <true/>
</dict>
</plist>
